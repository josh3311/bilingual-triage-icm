  "policies": [
    {
      "id": "P_late_delivery_EN",
      "topic": "late_delivery",
      "language": "EN",
      "title": "Late or missing package",
      "body": "Tracking updates can take up to 2 business days to appear. If a package has not arrived 14 days after it shipped, the team opens a trace request with the carrier."
    },
    {
      "id": "P_late_delivery_FR",
      "topic": "late_delivery",
      "language": "FR",
      "title": "Colis en retard ou introuvable",
      "body": "Les mises à jour du suivi peuvent prendre jusqu'à 2 jours ouvrables. Si un colis n'est pas arrivé 14 jours après son expédition, l'équipe ouvre une demande de recherche auprès du transporteur."
    },
    {
      "id": "P_double_charge_EN",
      "topic": "double_charge",
      "language": "EN",
      "title": "Charged twice for one order",
      "body": "A second charge on the same order is reviewed by the team, who compare the charge records. A pending charge can take 3 business days to clear."
    },
    {
      "id": "P_double_charge_FR",
      "topic": "double_charge",
      "language": "FR",
      "title": "Débité deux fois pour une commande",
      "body": "Un second prélèvement sur la même commande est examiné par l'équipe, qui compare les relevés. Un prélèvement en attente peut prendre 3 jours ouvrables à disparaître."
    },
    {
      "id": "P_billing_line_EN",
      "topic": "billing_line",
      "language": "EN",
      "title": "Questions about an invoice line",
      "body": "An invoice can include a service fee. The team explains each line on an invoice on request."
    },
    {
      "id": "P_billing_line_FR",
      "topic": "billing_line",
      "language": "FR",
      "title": "Questions sur une ligne de facture",
      "body": "Une facture peut comprendre des frais de service. L'équipe explique chaque ligne d'une facture sur demande."
    },
    {
      "id": "P_locked_account_EN",
      "topic": "locked_account",
      "language": "EN",
      "title": "Locked account",
      "body": "An account is locked after 5 failed login attempts. The team confirms who you are before unlocking it."
    },
    {
      "id": "P_locked_account_FR",
      "topic": "locked_account",
      "language": "FR",
      "title": "Compte bloqué",
      "body": "Un compte est bloqué après 5 tentatives de connexion échouées. L'équipe confirme votre identité avant de le débloquer."
    },
    {
      "id": "P_password_reset_EN",
      "topic": "password_reset",
      "language": "EN",
      "title": "Password reset email",
      "body": "The reset email goes to the address on the account. If it has not arrived after 10 minutes, check the spam folder."
    },
    {
      "id": "P_password_reset_FR",
      "topic": "password_reset",
      "language": "FR",
      "title": "Courriel de réinitialisation du mot de passe",
      "body": "Le courriel de réinitialisation est envoyé à l'adresse du compte. S'il n'est pas arrivé après 10 minutes, vérifiez le dossier des courriels indésirables."
    },
    {
      "id": "P_address_change_EN",
      "topic": "address_change",
      "language": "EN",
      "title": "Changing a delivery address",
      "body": "A delivery address can be changed only before an order ships. After it ships, the carrier handles any redirection."
    },
    {
      "id": "P_address_change_FR",
      "topic": "address_change",
      "language": "FR",
      "title": "Modifier une adresse de livraison",
      "body": "Une adresse de livraison ne peut être modifiée qu'avant l'expédition de la commande. Après l'expédition, le transporteur s'occupe de toute redirection."
    },
    {
      "id": "P_email_change_EN",
      "topic": "email_change",
      "language": "EN",
      "title": "Changing the account email",
      "body": "The email address on an account is changed in the account settings after the team confirms your identity."
    },
    {
      "id": "P_email_change_FR",
      "topic": "email_change",
      "language": "FR",
      "title": "Changer le courriel du compte",
      "body": "L'adresse courriel d'un compte se change dans les paramètres du compte, après que l'équipe a confirmé votre identité."
    },
    {
      "id": "P_receipt_EN",
      "topic": "receipt",
      "language": "EN",
      "title": "Receipt copies",
      "body": "A copy of the receipt is available for any paid order on request."
    },
    {
      "id": "P_receipt_FR",
      "topic": "receipt",
      "language": "FR",
      "title": "Copies de reçu",
      "body": "Une copie du reçu est disponible sur demande pour toute commande payée."
    },
    {
      "id": "P_holiday_hours_EN",
      "topic": "holiday_hours",
      "language": "EN",
      "title": "Holiday hours",
      "body": "Support is closed on December 25 and January 1. On December 24 and 31, support is open from 9 to 14."
    },
    {
      "id": "P_holiday_hours_FR",
      "topic": "holiday_hours",
      "language": "FR",
      "title": "Heures des fêtes",
      "body": "Le soutien est fermé le 25 décembre et le 1er janvier. Les 24 et 31 décembre, le soutien est ouvert de 9 h à 14 h."
    },
    {
      "id": "P_sunday_delivery_EN",
      "topic": "sunday_delivery",
      "language": "EN",
      "title": "Sunday delivery",
      "body": "Deliveries are made Monday to Saturday. There are no Sunday deliveries."
    },
    {
      "id": "P_sunday_delivery_FR",
      "topic": "sunday_delivery",
      "language": "FR",
      "title": "Livraison le dimanche",
      "body": "Les livraisons ont lieu du lundi au samedi. Il n'y a pas de livraison le dimanche."
    },
    {
      "id": "P_return_policy_EN",
      "topic": "return_policy",
      "language": "EN",
      "title": "Returns",
      "body": "Items can be returned within 30 days of delivery. The team reviews each return request."
    },
    {
      "id": "P_return_policy_FR",
      "topic": "return_policy",
      "language": "FR",
      "title": "Retours",
      "body": "Les articles peuvent être retournés dans les 30 jours suivant la livraison. L'équipe examine chaque demande de retour."
    },
    {
      "id": "P_product_defect_EN",
      "topic": "product_defect",
      "language": "EN",
      "title": "Damaged or faulty items",
      "body": "An item that arrives damaged or does not work is reviewed by the team, who may ask for photos."
    },
    {
      "id": "P_product_defect_FR",
      "topic": "product_defect",
      "language": "FR",
      "title": "Article endommagé ou défectueux",
      "body": "Un article qui arrive endommagé ou qui ne fonctionne pas est examiné par l'équipe, qui peut demander des photos."
    },
    {
      "id": "P_app_issue_EN",
      "topic": "app_issue",
      "language": "EN",
      "title": "App problems",
      "body": "App problems are reviewed by technical support, who may ask for the app version and the device model."
    },
    {
      "id": "P_app_issue_FR",
      "topic": "app_issue",
      "language": "FR",
      "title": "Problèmes avec l'application",
      "body": "Les problèmes d'application sont examinés par le soutien technique, qui peut demander la version de l'application et le modèle de l'appareil."
    },
    {
      "id": "P_complaint_EN",
      "topic": "complaint",
      "language": "EN",
      "title": "Service complaints",
      "body": "A service complaint is reviewed by a team lead, who may listen to the call record."
    },
    {
      "id": "P_complaint_FR",
      "topic": "complaint",
      "language": "FR",
      "title": "Plaintes sur le service",
      "body": "Une plainte sur le service est examinée par un chef d'équipe, qui peut écouter l'enregistrement de l'appel."
    },
    {
      "id": "P_general_EN",
      "topic": "general",
      "language": "EN",
      "title": "General questions",
      "body": "Questions that do not fit another topic are answered by the general support queue."
    },
    {
      "id": "P_general_FR",
      "topic": "general",
      "language": "FR",
      "title": "Questions générales",
      "body": "Les questions qui ne correspondent à aucun autre sujet sont traitées par la file de soutien général."
